[Unit]
Description=cod-agent — Telegram COD sales agent (Olavita)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/cod_agent
EnvironmentFile=/srv/cod_agent/config.env
Environment=COD_AGENT_PROD_OK=1
ExecStart=/srv/cod_agent/venv/bin/python bot.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
