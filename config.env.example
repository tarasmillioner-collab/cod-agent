# cod-agent — скопировать в config.env (на VPS: /srv/cod_agent/config.env, chmod 600)
# prod | test (prod запрещает локальный запуск с прод-токеном)
ENV=test
BOT_TOKEN=PLACEHOLDER
# tg id через запятую, кому можно /bot /stats
ADMIN_IDS=
# супергруппа-форум менеджеров (бот — админ с правом тем)
MANAGERS_CHAT_ID=0
# LLM: підписка Claude Code (пріоритет) АБО API-ключ
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
LPCRM_SUBDOMAIN=tallside
# «вихідний» ключ из LP-CRM
LPCRM_API_KEY_IN=
LPCRM_API_KEY=
# 0 — реально создавать заказы
LPCRM_DRY_RUN=1
LPCRM_SITE=olavita.skinactivelab.com
LPCRM_OFFICE=13
LPCRM_STATUS_CONFIRMED=11
# Нова Пошта API (справочники работают и без ключа)
NP_API_KEY=
DB_PATH=var/cod.db
OFFER_PATH=offer.yaml
PROMPT_PATH=prompts/system.md
BLACKLIST_PATH=ua_blacklist.txt
LLM_DAILY_USD_CAP=15
VOICE_ENABLED=0
ELEVENLABS_API_KEY=
